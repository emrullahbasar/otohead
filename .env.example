# Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin. .env asla commit edilmemeli
# (bkz. .gitignore) — EXPO_PUBLIC_* önekli her değer build sırasında JS bundle'ına gömülür,
# bu yüzden burada yalnızca gerçekten public olması güvenli değerler bulunmalı.


# Google Apps Script web app URL'i (araç önerisi / değerlendirme backend'i).
# Kimlik doğrulama artık statik bir anahtara değil, cihaza özel register akışına
# dayanıyor — bkz. src/services/suggestionApi.ts ve SECURITY-AUDIT.md SEC-001.
EXPO_PUBLIC_APPS_SCRIPT_URL=
